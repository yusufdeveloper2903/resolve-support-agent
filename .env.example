# Copy to .env (gitignored). Only ANTHROPIC_API_KEY is needed for live agent runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
RESOLVE_DB_PATH=./data/resolve.db
# Customer the MCP server acts on behalf of (tools are always scoped to one customer).
RESOLVE_MCP_CUSTOMER_ID=C-1001
